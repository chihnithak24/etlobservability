# Development — Vite proxy rewrites /api → http://localhost:5000
# so VITE_API_URL is not needed locally. The default in api.js is '/api'.
# Uncomment and set this only if your backend runs on a non-default port or host.
# VITE_API_URL=http://localhost:5000/api
VITE_API_URL=https://etlobservability-2.onrender.com/api

# Optional: Set your Google Cloud OAuth Client ID for live Google Sign-In
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
