# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/etldb
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/etldb?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/etldb

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_before_deploying

# ── Frontend origin (CORS in production) ──────────────────────────────────────
# Dev default: http://localhost:3000  |  Prod: your Render/Vercel URL
FRONTEND_URL=http://localhost:3000

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Email / Nodemailer ────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email alerts entirely.
# Gmail:    smtp.gmail.com   port 587  (enable 2FA + App Password)
# Ethereal: smtp.ethereal.email  port 587  (free test inbox, no real delivery)
# SendGrid: smtp.sendgrid.net  port 587  user=apikey  pass=SG.xxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ETL Predict AI" <noreply@etl-predict.local>
EMAIL_TO=admin@etl.com
EMAIL_RISK_THRESHOLD=70

# ── Apache Airflow REST API ────────────────────────────────────────────────────
#
# AIRFLOW_BASE_URL — URL of your Airflow web-server (NO trailing slash).# This value is required and must be the actual Airflow UI/webserver address.# The backend appends /api/v1 and uses HTTP Basic Auth on every request.
#
# Provider examples:
#   Local Docker Compose : http://localhost:8080
#   Astronomer Cloud     : https://<org>.astronomer.run/<deployment>
#   AWS MWAA             : https://<env-id>.airflow.amazonaws.com
#   Google Cloud Composer: https://<region>-<project>-dot-<id>.appspot.com
#   Azure ADF Managed    : https://<id>.eastus.airflow.svc.azureml.ms
#
AIRFLOW_BASE_URL=http://localhost:8080

# HTTP Basic Auth credentials.
# For a local Airflow webserver with default authentication, use an admin user.
# If Airflow is configured without authentication, leave these blank and do not set AIRFLOW_API_TOKEN.
# For token-based auth, set AIRFLOW_API_TOKEN instead of AIRFLOW_USERNAME/PASSWORD.
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
# AIRFLOW_API_TOKEN=

# Per-request timeout in milliseconds (default 10 000).
AIRFLOW_API_TIMEOUT_MS=10000

# Polling cadence in milliseconds — how often the backend fetches new DAG runs (default 30 000).
AIRFLOW_SYNC_INTERVAL_MS=30000

# Max DAG runs fetched per polling cycle (default 50).
AIRFLOW_SYNC_LIMIT=50

# Set to "false" to disable Airflow polling (app still works with manual job management).
AIRFLOW_ENABLED=true

# Note: Local Airflow must be started separately before the backend can poll real DAG runs.
# Use the configured AIRFLOW_BASE_URL and valid Airflow credentials/token.
