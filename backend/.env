PORT=5000
MONGO_URI=mongodb://localhost:27017/etl_system
JWT_SECRET=etl_super_secret_jwt_key_2024
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development

# ── Apache Airflow REST API ─────────────────────────────────────────────────
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_API_TIMEOUT_MS=10000
AIRFLOW_SYNC_INTERVAL_MS=30000
AIRFLOW_SYNC_LIMIT=50
AIRFLOW_ENABLED=false

# ── Email / Nodemailer ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications (app still works).
#
# Option A — Gmail (App Password required, 2FA must be on)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
#
# Option B — Ethereal (free fake SMTP for testing, auto-generates credentials)
# Run: node -e "require('nodemailer').createTestAccount().then(a=>console.log(a))"
# then fill in the values printed.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<ethereal_user>
# SMTP_PASS=<ethereal_pass>
#
# Option C — Any SMTP relay (SendGrid, SES, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=<sendgrid_api_key>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender address shown in the From field
EMAIL_FROM="ETL Predict AI" <noreply@etl-predict.local>
# Recipient for all alert emails
EMAIL_TO=admin@etl.com
# Minimum AI risk score that triggers a high-risk email (0-100)
EMAIL_RISK_THRESHOLD=70
